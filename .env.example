# Public origin used to validate same-origin requests and build absolute URLs.
APP_ORIGIN=http://localhost:3000

# Persistent local SQLite file. The data directory is intentionally not committed.
DATABASE_PATH=./data/service-operations-portal.sqlite

# Name of the secure, HTTP-only session cookie.
SESSION_COOKIE_NAME=service_portal_session

# Temporary default for the local MVP. Confirm the production policy before deployment.
SESSION_TTL_HOURS=12
